PORT=3000

# Google Drive organization root folder - contains one subfolder per campus
DRIVE_ROOT_FOLDER_ID=

# Which campus subfolder (under DRIVE_ROOT_FOLDER_ID) this Mac Mini serves
CAMPUS=

# Basic auth for /control (defense in depth with Cloudflare Access / Tailscale).
# REQUIRED: change CONTROL_PASSWORD before exposing /control remotely.
# Generate one: openssl rand -base64 24
CONTROL_USER=admin
CONTROL_PASSWORD=changeme

# Sync intervals (cron expressions)
SYNC_CRON_DEFAULT=*/15 * * * *
SYNC_CRON_SUNDAY=* * * * 0
